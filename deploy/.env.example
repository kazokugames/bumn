# Salin menjadi deploy/.env di server (berkas .env tidak ikut git). Jangan menaruh rahasia di berkas lain.

# --- Cara akses ---
# Port di server. Pilih yang BELUM dipakai (cek: docker ps --format '{{.Names}} {{.Ports}}' dan ss -tlnp).
APP_PORT=3100
# 127.0.0.1 = hanya dari server itu sendiri (aman, dipakai bersama tunnel). Isi 0.0.0.0 hanya untuk uji lewat http://IP:PORT (tanpa HTTPS, tidak aman).
BIND=127.0.0.1

# --- HTTPS lewat Cloudflare Tunnel (disarankan) ---
# Token dari Cloudflare Zero Trust > Networks > Tunnels. Public hostname -> Service: http://app:3000
TUNNEL_TOKEN=
# Header IP klien yang dipercaya. Dengan Cloudflare Tunnel: cf-connecting-ip. Tanpa proxy sama sekali: none
IP_HEADER=cf-connecting-ip
# 1 bila diakses lewat HTTPS. Isi 0 hanya untuk uji http://IP:PORT.
COOKIE_SECURE=1

# --- Pendaftaran ---
# buka = siapa saja boleh daftar; tutup = hanya master yang membuat akun; kode = daftar wajib memakai kode aktivasi
REGISTRASI=buka

# --- Identitas bimbel (satu image yang sama untuk semua bimbel) ---
NAMA_BIMBEL=
# Warna utama format #rrggbb, kosong = bawaan
WARNA=
# Isi angka (hari) agar pendaftar tanpa kode mendapat masa uji; kosong = tanpa batas waktu
MASA_UJI_HARI=
