# Salin menjadi .env.local (atau set sebagai variabel lingkungan di server).

# Lokasi file database SQLite. Pastikan foldernya ada dan bisa ditulis oleh user yang menjalankan aplikasi.
DB_PATH=/var/lib/bumn/app.db

# Wajib "1" bila situs dilayani lewat HTTPS (cookie sesi hanya dikirim lewat HTTPS).
COOKIE_SECURE=1

# Isi "tutup" untuk menutup pendaftaran mandiri (akun hanya dibuat master).
# REGISTRASI=tutup
